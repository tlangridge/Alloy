# alloy configuration  (copy to ~/.config/alloy/config and edit)
#
# This file is parsed as simple KEY=value lines. It is NEVER executed as a
# shell script, so it is safe even if a copy ends up in a project directory.
# Lines starting with '#' and blank lines are ignored. Environment variables
# of the same name override values here.

# Which adapters form the panel (comma-separated, in order).
# LEAVE UNSET to use the default: the COMPLETE SET of available models -- every
# verified read-only CLI that is installed + authenticated (codex, grok,
# antigravity/Gemini on agy >= 1.1, a fresh `claude` instance, and `cursor` on
# macOS once its OS sandbox self-test passes). Set this only to pin a narrower/
# cheaper panel. `llm` is read-only but experimental (opt-in); opencode (and an
# agy older than 1.1) have no real read-only mode and are skipped unless
# ALLOY_ALLOW_UNSANDBOXED=1. Cursor's name is `cursor`; the old name `cursor-agent`
# is still accepted here and means the same thing. Cursor is refused on Linux and
# whenever its sandbox is unavailable, and ALLOY_ALLOW_UNSANDBOXED never overrides
# that.
# ALLOY_PANELISTS=codex,grok

# Per-panelist timeout in seconds (a panel runs in parallel, so this is the max,
# not the sum). A still-running panelist is killed at this; raise it for very
# heavy prompts.
ALLOY_TIMEOUT=300

# How often (seconds) a long-running panelist logs a progress heartbeat
# (bytes produced + idle age), so you can tell slow-but-working from hung.
ALLOY_HEARTBEAT=30

# Optional stall kill: if >0, kill a panelist that has produced no new output for
# this many seconds. OFF (0) by default -- reasoning CLIs are legitimately silent
# while they think, so silence is not a reliable "dead" signal.
ALLOY_STALL_TIMEOUT=0

# Cap on each panelist's captured output (characters). Protects the host's
# context window from a runaway panelist. Truncation is recorded in the manifest.
ALLOY_MAX_CHARS=200000

# Cap on total prompt size in bytes (the prompt plus any --attach files).
# Guards against a huge prompt exhausting memory before output caps apply.
ALLOY_MAX_PROMPT_BYTES=4000000

# Web research: panelists may search the web (codex tools.web_search; grok and
# claude search the web in plan mode). On by default; set to 0 to disable (codex).
ALLOY_WEB=1

# Repo access (ON by default): read-only panelists run in your real working tree
# (auto-detected git root) so they can read your code; their CLI read-only flag
# prevents writes (best-effort). Set `none` for no access (empty throwaway cwd),
# or an absolute path to pin a specific repo. Per-run: --repo PATH / --no-repo.
# ALLOY_REPO=none

# Self-healing retry: re-dispatch a panelist exactly ONCE (never a loop) when its
# first attempt failed with one of these statuses. Default `auth` catches the
# transient token-refresh race (an OAuth CLI whose token expires at dispatch
# fails that one call but refreshes it, so the retry succeeds). Use `auth,empty`
# to also re-ask blank answers; set 0/off/none to disable.
# ALLOY_RETRY=auth

# Optional: comma-separated files to fold into every prompt as read-only
# reference context (also available per-run as `--attach`). Unset by default.
# ALLOY_ATTACH=src/foo.ts,src/bar.ts

# Optional model overrides (leave unset to use each CLI's default model).
# ALLOY_CODEX_MODEL=gpt-6.1-sol
# ALLOY_ANTIGRAVITY_MODEL=gemini-3.1-pro-high  # unset -> gemini-3.6-flash-high; `agy models` lists the rest
# ALLOY_ANTIGRAVITY_EFFORT=high        # agy reasoning effort (low|medium|high)
# ALLOY_ANTIGRAVITY_HOME=run           # throwaway agy HOME per run instead of the shared alloy-owned one
# ALLOY_GROK_MODEL=grok-4.5            # unset -> grok's default, now grok-4.6
# ALLOY_CLAUDE_MODEL=opus              # alias (opus/sonnet/fable) or a full id

# Cursor (`cursor`; the executable is `cursor-agent`). Log in with
# `cursor-agent login`. Every Cursor call names one explicit model; `auto` and
# unknown model IDs are refused, so a plain panel uses composer-2.5 unless pinned.
# A model's family comes from its ID: claude-* anthropic, gpt-* openai, gemini-*
# google, grok-*/cursor-grok-* xai, composer-* cursor (Cursor's own family).
# Prefer Cursor-native models (composer-*, cursor-grok-*): they draw the
# `cursor:models` quota pool. Every other model through Cursor draws the more
# expensive `cursor:other` pool. See docs/usage.md.
# ALLOY_BIN_CURSOR=/absolute/path/to/cursor-agent
# ALLOY_CURSOR_MODEL=composer-2.5
# ALLOY_CURSOR_EFFORT=high             # none|minimal|low|medium|high|xhigh|max; sent inside --model
# Legacy names, read only when the canonical one is unset (the canonical key wins):
# ALLOY_BIN_CURSOR_AGENT, ALLOY_CURSOR_AGENT_MODEL (deprecated; doctor warns),
# ALLOY_CURSOR_AGENT_EFFORT.
# Extra files or directories Cursor may never READ, comma-separated absolute
# paths (no globs). Additive only: the built-in list (SSH, cloud, GPG, gh, keychain,
# other agent CLIs' credentials, Alloy's own config, and anything directly under
# /tmp or /private/tmp whose name contains "secret") always applies and cannot be
# removed. A denial that covers a path Cursor must read makes Cursor refuse to run.
# ALLOY_CURSOR_DENY_READ_PATHS=/absolute/path/one,/absolute/path/two
# CURSOR_API_KEY and CURSOR_API_ENDPOINT are deliberately NOT supported: Alloy
# removes both from every child process's environment (whether they came from
# your shell or from this file) and rejects --api-key/--endpoint/--header, so
# only Cursor's own login is ever used.

# Codex reasoning effort for panel runs. Default "high" keeps runs inside the
# timeout; otherwise a global `model_reasoning_effort = "xhigh"` in
# ~/.codex/config.toml gets inherited and can blow past it. Use medium/high/xhigh,
# or "inherit" to use whatever your codex config sets.
ALLOY_CODEX_EFFORT=high

# Who judges the panel. Default is the host (whichever agent invoked the skill).
# Judge rotation to a CLI is on the roadmap; today this is informational.
# ALLOY_JUDGE=host

# Where run output (prompts, per-panelist answers, manifest.json) is written.
# Default: $XDG_STATE_HOME/alloy/runs (i.e. ~/.local/state/alloy/runs) -- kept
# OUTSIDE your repo so prompts/diffs and CLI output are never committed.
# ALLOY_RUN_ROOT=~/.cache/alloy/runs

# DANGER: allow adapters that have no real read-only mode (e.g. opencode, or an
# agy older than 1.1). Off by default. Such a panelist can write files and run
# shell; alloy never gives it your real repo (it gets a disposable COPY instead),
# but its writes/shell are otherwise uncontained. Only enable if you accept that.
# This never applies to Cursor, which runs only inside its macOS sandbox.
# ALLOY_ALLOW_UNSANDBOXED=0

# Skill startup automatically installs stable releases on clean official Git installs.
# Set to 0 for check-only operation, or disable all checks with the second option.
# ALLOY_AUTO_UPDATE=1
# ALLOY_NO_UPDATE_CHECK=0

# Subscription meters: native Codex/Antigravity/Grok usage reads and, for Claude,
# a credentials file, the opt-in status-line hook or the opt-in probe (Alloy never
# reads the macOS keychain), cached for two minutes and included in panel/route
# context. Cursor's CLI exposes no usage, so Cursor quota is unknown unless you
# set it by hand in routing.json. No generation calls unless you opt in to the
# Claude probe. See docs/usage.md. In routing.json, `usage.reserve_fraction`
# defaults to 0.1; 0.15 is recommended.
# ALLOY_USAGE=off
