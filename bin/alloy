    # inherited value is never what reaches the child; it is listed because it is a name the
    # child is meant to see.
    "CURSOR_INVOKED_AS",
    "CURSOR_DATA_DIR", "CURSOR_CONFIG_DIR",  # always replaced with private state
    "AGENT_CLI_CREDENTIAL_STORE",       # always overwritten with file, never inherited
)
