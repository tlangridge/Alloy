# Lock before loading companion modules, and keep it until process exit. Checks
# never replace code while an Alloy invocation is running in this installation.
_INSTALL_LOCK = None
if __name__ == '__main__':
    try:
        _INSTALL_LOCK = updater.acquire(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                                        exclusive=len(sys.argv) > 1 and sys.argv[1] == 'update-check')
    except BlockingIOError:
        print('UPDATE_CHECK_SKIPPED (another Alloy invocation is active)')
        sys.exit(0)
    except OSError:
        if len(sys.argv) > 1 and sys.argv[1] == 'update-check':
            print('UPDATE_SKIPPED (installation lock unavailable)')
            sys.exit(0)
