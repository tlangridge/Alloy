MANIFEST_SCHEMA = 1

DEFAULT_TIMEOUT_S = 300            # generous; a panel runs in parallel, so this is the max, not the sum
# A Maker (`--mode make`, the execute mode's implementer) is a different workload
# from a consult panelist: ONE model that has to explore an unfamiliar repo
# before it can emit a diff, and a timeout there is lost work, not a partial
# panel. It gets its own, much larger default (ALLOY_MAKER_TIMEOUT / --timeout).
DEFAULT_MAKER_TIMEOUT_S = 1800
