# secrets": ambient credentials (AWS_*, GITHUB_TOKEN, OPENAI_API_KEY, ...) and IPC
# hooks (SSH_AUTH_SOCK, TMUX, STY, DOCKER_HOST, VSCODE_IPC_HOOK*, ...) never reach it.
CURSOR_ENV_ALLOW = (
    "PATH", "LANG", "LANGUAGE", "TZ", "USER", "LOGNAME", "SHELL", "TERM", "COLORTERM",
