TRUNCATION_MARKER = "\n\n[... alloy: output truncated at {n} characters ...]\n"

# Track spawned process groups so we can clean them up on SIGINT/SIGTERM.
_LIVE_PGIDS: "set[int]" = set()
_LIVE_LOCK = threading.Lock()
_STDERR_LOCK = threading.Lock()


# --------------------------------------------------------------------------- #
# small helpers
# --------------------------------------------------------------------------- #
def now_utc_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def log(msg: str) -> None:
    """Progress goes to stderr so a 30-45s parallel dispatch never looks hung,
    and so it never pollutes the stdout the host parses."""
    with _STDERR_LOCK:
        sys.stderr.write("[alloy] " + msg + "\n")
        sys.stderr.flush()


def _chmod(path: str, mode: int) -> None:
    try:
        os.chmod(path, mode)
    except OSError:
        pass


def write_atomic(path: str, data: str) -> None:
    # mkstemp, not a fixed path+".tmp": two alloy processes sharing a state dir
    # (panel + doctor, or two concurrent panels) would otherwise open the SAME
    # tmp file and the loser writes through the renamed inode -- a torn file.
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".",
                               prefix=os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(data)
        _chmod(tmp, 0o600)  # run artifacts may hold prompt/diff text; replace preserves mode
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _relink(src: str, dst: str) -> None:
    """Idempotently point symlink dst at src, repairing a stale or broken link
    (e.g. the user's home moved, or the state dir was restored on another
    machine). Failures are swallowed -- callers treat the link as optional."""
    try:
        if os.path.islink(dst) and os.readlink(dst) != src:
            os.unlink(dst)
        if not os.path.lexists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            os.symlink(src, dst)
    except OSError:
        pass


def _is_within(path: str, base: str) -> bool:
    """True if `path` is inside directory `base` (used to refuse a panelist
    binary that PATH resolved from inside the current working directory)."""
    try:
        return os.path.commonpath([os.path.abspath(path), base]) == base
    except ValueError:
        return False  # different drives / not comparable


def read_text(path: str, max_bytes: "int | None" = None) -> str:
    # max_bytes bounds memory: a runaway panelist can write a multi-GB file, so
    # never f.read() it whole.
    try:
        with open(path, "rb") as f:
            data = f.read(max_bytes) if max_bytes is not None else f.read()
        return data.decode("utf-8", errors="replace")
    except FileNotFoundError:
        return ""


def read_tail(path: str, max_bytes: int) -> str:
    """The last max_bytes of a file: machine-readable usage trails the output."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - max_bytes))
            data = f.read()
        return data.decode("utf-8", errors="replace")
    except (FileNotFoundError, OSError):
        return ""


# --------------------------------------------------------------------------- #
# token usage capture (opt-in; ALLOY_CAPTURE_USAGE=1)
# --------------------------------------------------------------------------- #
# Each CLI can report its own token usage, but only in a machine-readable output
# mode. Capture switches to that mode, extracts the answer text exactly as the
# plain mode would print it, and records normalized counts in status["usage"]:
#   input_tokens       uncached prompt tokens (billed at the full input rate)
#   cache_read_tokens  prompt tokens served from the provider's prompt cache
#   cache_write_tokens prompt tokens written to the cache (Anthropic-style)
#   output_tokens      generated tokens INCLUDING reasoning/thinking
#   reasoning_tokens   the reasoning/thinking share of output_tokens
#   reported_cost_usd  the CLI's own API-list-price estimate, when it prints one
# Counts are provider-reported, not verified; subscription billing differs.
USAGE_TAIL_BYTES = 4_000_000


def capture_usage() -> bool:
    return (setting("ALLOY_CAPTURE_USAGE", "0") or "0").lower() in ("1", "true", "yes", "on")


def json_object(text: str) -> "dict | None":
    text = text.strip()
    if not text.startswith("{"):
        return None
    try:
        value = json.loads(text)
    except ValueError:
        return None
    return value if isinstance(value, dict) else None


def _count(value) -> int:
    return value if isinstance(value, int) and not isinstance(value, bool) and value > 0 else 0


def _usage(input_tokens=0, cache_read=0, cache_write=0, output=0, reasoning=0,
           cost=None, turns=None, source="") -> dict:
    return {"input_tokens": _count(input_tokens), "cache_read_tokens": _count(cache_read),
            "cache_write_tokens": _count(cache_write), "output_tokens": _count(output),
            "reasoning_tokens": _count(reasoning),
            "reported_cost_usd": cost if isinstance(cost, (int, float)) and not isinstance(cost, bool) else None,
            "turns": turns if isinstance(turns, int) and not isinstance(turns, bool) else None,
            "source": source}


def _swap_flag(argv: "list[str]", flag: str, value: str) -> "list[str]":
    argv = list(argv)
    if flag in argv and argv.index(flag) + 1 < len(argv):
        argv[argv.index(flag) + 1] = value
    else:
        argv += [flag, value]
    return argv


# Strip CSI colour codes AND OSC sequences (e.g. OSC 52 clipboard-write, OSC 8
# hyperlinks) so a panelist cannot smuggle a terminal-control payload into the
# saved result that fires when a user `cat`s it.
ANSI_RE = re.compile(
    r"\x1b(?:\[[0-9;?]*[ -/]*[@-~]|\][0-9;]*;?.*?(?:\x07|\x1b\\))",
    re.DOTALL,  # so an OSC payload containing a newline can't slip past the stripper
)


def strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text)


# --------------------------------------------------------------------------- #
# secret redaction (scan PANELIST OUTPUT before persisting)
# --------------------------------------------------------------------------- #
# Best-effort secret scrubbing of panelist OUTPUT before it is persisted or read
# by the host. Value-shaped patterns catch high-entropy keys regardless of the
# variable name; the assignment pattern is a name-based backstop. This is a
# heuristic, not a guarantee.
SECRET_PATTERNS = [
    ("openai_key", re.compile(r"sk-(?:proj-)?[A-Za-z0-9_-]{20,}")),
    ("anthropic_key", re.compile(r"sk-ant-[A-Za-z0-9_-]{20,}")),
    ("stripe_key", re.compile(r"\b[sr]k_(?:live|test)_[A-Za-z0-9]{16,}\b")),
    ("aws_access_key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("google_api_key", re.compile(r"\bAIza[0-9A-Za-z_\-]{35}\b")),
    ("gh_token", re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b")),
    ("gh_pat", re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}\b")),
    ("gitlab_pat", re.compile(r"\bglpat-[A-Za-z0-9_\-]{16,}\b")),
    ("npm_token", re.compile(r"\bnpm_[A-Za-z0-9]{30,}\b")),
    ("slack_token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
    ("jwt", re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{6,}\b")),
    # Header values are opaque. Cover every Authorization scheme (and proxy
    # form), plus cookie headers; name-shaped custom headers such as X-Api-Key
    # and X-Auth-Token are handled by ASSIGNED_SECRET_RE below.
    ("authorization_header", re.compile(
        r"(?i)\b(?:Proxy-)?Authorization\s*:\s*[^\r\n]+")),
    ("cookie_header", re.compile(
        r"(?i)\b(?:Set-)?Cookie\s*:\s*[^\r\n]+")),
    # Custom authentication headers may carry a scheme word before the actual
    # value (`X-Auth-Token: Bearer ...`, `X-Api-Key: Token ...`). Match the
    # complete header so the assignment backstop cannot redact only the scheme.
    ("custom_secret_header", re.compile(
        r"(?i)\bX-(?:[A-Za-z0-9]+-)*(?:Api-Key|Auth-Token|Key|Token|Secret|Password)"
        r"(?:-[A-Za-z0-9]+)*\s*:\s*[^\r\n]+")),
    # Whole PEM block (BEGIN..END), or BEGIN..end-of-text if truncated.
    ("private_key", re.compile(
        r"-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY-----"
        r"[\s\S]*?(?:-----END (?:[A-Z ]+ )?PRIVATE KEY-----|\Z)")),
]

# Name=value backstop. The name may have a suffix past the keyword
# (AWS_SECRET_ACCESS_KEY, SECRET_KEY_BASE, DB_PASSWORD_HASH), so allow trailing
# word chars and anchor on the assignment rather than a word boundary.
# Captures: (1) name + operator, (2) opening quote (maybe empty), (3) value,
# (4) matching closing quote -- so the replacement preserves the operator and
# quotes and the redacted line stays valid syntax for the host to read.
ASSIGNED_SECRET_RE = re.compile(
    r"(?i)(\b[A-Z0-9_-]*(?:API[-_]?KEY|SECRET|TOKEN|PASSWORD|PASSWD)[A-Z0-9_-]*"
    r"\s*[:=]\s*)(['\"]?)([^\s'\"]{6,})(\2)"
)
# Fallback for malformed/raw JSON text. Valid JSON is structurally redacted
# before persistence, but an escaped quoted assignment must still fail safe when
# parsing fails: API_KEY=\"value\".
ESCAPED_ASSIGNED_SECRET_RE = re.compile(
    r"(?i)(\b[A-Z0-9_-]*(?:API[-_]?KEY|SECRET|TOKEN|PASSWORD|PASSWD)[A-Z0-9_-]*"
    r'\s*[:=]\s*)(\\")([^"\\\s]{6,})(\\")'
)


def redact_secrets(text: str) -> "tuple[str, int]":
    count = 0

    # Run the assignment backstop FIRST so it cannot re-match (and double-count)
    # the [REDACTED:...] placeholders the value patterns below insert.
    def _sub_escaped_assigned(m: "re.Match[str]") -> str:
        nonlocal count
        count += 1
        return f"{m.group(1)}{m.group(2)}[REDACTED]{m.group(4)}"

    def _sub_assigned(m: "re.Match[str]") -> str:
        nonlocal count
        if "[REDACTED" in m.group(3):
            return m.group(0)
        count += 1
        return f"{m.group(1)}{m.group(2)}[REDACTED]{m.group(4)}"

    text = ESCAPED_ASSIGNED_SECRET_RE.sub(_sub_escaped_assigned, text)
    text = ASSIGNED_SECRET_RE.sub(_sub_assigned, text)

    for name, pat in SECRET_PATTERNS:
        def _sub(m: "re.Match[str]", _n: str = name) -> str:
            nonlocal count
            count += 1
            return f"[REDACTED:{_n}]"

        text = pat.sub(_sub, text)
    return text, count


def redact_tree(obj):
    """redact_secrets over every string leaf of a JSON-shaped value (keys untouched),
    so a whole status payload -- each `command` element included -- is scrubbed
    without ever producing invalid JSON. Returns (redacted copy, redaction count)."""
    if isinstance(obj, str):
        return redact_secrets(obj)
    if isinstance(obj, dict):
        out, total = {}, 0
        for key, value in obj.items():
            out[key], n = redact_tree(value)
            total += n
        return out, total
    if isinstance(obj, (list, tuple)):
        items = [redact_tree(v) for v in obj]
        return [v for v, _ in items], sum(n for _, n in items)
    return obj, 0


def redact_json_text(text: str) -> "tuple[str, int]":
    """Redact every string leaf in one JSON value before re-serializing it.
    Malformed output still receives the text scrubber, including escaped
    assignment handling, so raw JSON syntax never creates a redaction bypass."""
    try:
        value = json.loads(text)
    except (TypeError, ValueError):
        return redact_secrets(text)
    redacted, count = redact_tree(value)
    if not count:
        return text, 0
    body = json.dumps(redacted, ensure_ascii=False, separators=(",", ":"))
    return body + ("\n" if text.endswith("\n") else ""), count


def cap_chars(text: str, max_chars: int) -> "tuple[str, bool]":
    if len(text) <= max_chars:
        return text, False
    return text[:max_chars] + TRUNCATION_MARKER.format(n=max_chars), True


# --------------------------------------------------------------------------- #
# configuration (env + optional KEY=value file; NEVER sourced as shell)
# --------------------------------------------------------------------------- #
def config_path() -> str:
    if os.environ.get("ALLOY_CONFIG"):
        return os.environ["ALLOY_CONFIG"]
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        os.path.expanduser("~"), ".config"
    )
    return os.path.join(base, "alloy", "config")


def load_config() -> "dict[str, str]":
    """Read KEY=value lines from the user-level config file. No shell eval, no
    project-local file. Lines starting with '#' and blank lines are ignored."""
    cfg: "dict[str, str]" = {}
    path = config_path()
    try:
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                cfg[key.strip()] = val.strip().strip("'\"")
    except FileNotFoundError:
        pass
    return cfg


_CONFIG = load_config()


def setting(key: str, default: "str | None" = None) -> "str | None":
    """Resolution order: environment variable > config file > default."""
    if key in os.environ and os.environ[key] != "":
        return os.environ[key]
    if key in _CONFIG and _CONFIG[key] != "":
        return _CONFIG[key]
    return default


def setting_int(key: str, default: int) -> int:
    raw = setting(key)
    try:
        return int(raw) if raw is not None else default
    except ValueError:
        return default


# --------------------------------------------------------------------------- #
# adapters: the 5-function contract
#   detect()       -> is the binary on PATH?
#   auth_state()   -> 'ready' | 'installed_not_authed' | 'not_installed'
#   build_args()   -> argv AFTER the binary (prompt is on stdin; `ctx` carries
#                     the run's repo/pdir/timeout for CLIs that need them)
#   parse()        -> clean answer text from (stdout, stderr, last_message)
#   capabilities() -> {read_only, supports_json, default_model, ...}
#   prepare_env()  -> optional env overrides for the child (e.g. an isolated HOME)
# Optional runner hooks (defaults change nothing): stdin_from_prompt, capture_in_memory,
# open_scope()/wrap_argv()/before_spawn()/after_exit() (a per-dispatch resource, the
# final spawn gateway and a post-run tripwire), output_error(), provider_meta(),
# read_stdout() (which part of a large stdout sidecar the engine parses) and
# observe_output() (a side channel over the finished stdout, e.g. Claude quota).
# See docs/adding-a-panelist.md for the full contract and a template.
# --------------------------------------------------------------------------- #
class Adapter:
    name = "base"
    bin = "base"
    read_only = False
    experimental = False
    install_hint = ""
    auth_hint = ""
    # Runner hooks. Defaults keep every existing adapter's behaviour unchanged.
    stdin_from_prompt = True        # False: stdin is DEVNULL (the prompt is a staged file)
    capture_in_memory = False       # True: drain pipes into bounded memory, never into sidecars
    kill_group_on_exit = False      # True: always reap the whole process group before returning
    requires_os_boundary = False    # True: refused unless cursor_boundary_ready, whatever else is set
    bin_env_keys: "tuple[str, ...]" = ()

    # -- detection / auth ---------------------------------------------------- #
    def bin_override(self) -> "str | None":
        keys = self.bin_env_keys or ("ALLOY_BIN_" + self.name.upper().replace("-", "_"),)
        for key in keys:
            value = setting(key)
            if value:
                return value
        return None

    def resolved_bin(self) -> "str | None":
        override = self.bin_override()
        if override:
            override = os.path.expanduser(override)
            if os.sep in override:        # a path: make absolute (child runs in a different cwd)
                return os.path.abspath(override)
            return shutil.which(override) or override   # a bare name: resolve on PATH
        return shutil.which(self.bin)

    def detect(self) -> bool:
        return self.resolved_bin() is not None

    def auth_state(self) -> str:
        if not self.detect():
            return "not_installed"
        return "ready" if self.is_authed() else "installed_not_authed"

    def is_authed(self) -> bool:  # best-effort heuristic, overridden per adapter
        return True

    def auth_status(self, state: str) -> "str | None":
        """What `doctor` reports about login, honestly: 'authenticated' (evidence
        found), 'not_authenticated', 'unknown' (the state cannot be known without
        reading something Alloy never reads), or None when there is nothing to say."""
        return {"ready": "authenticated", "installed_not_authed": "not_authenticated"}.get(state)

    def auth_note(self) -> str:
        """Why `doctor` shows auth `unknown`. Neutral by default; an adapter that returns
        `unknown` says its own reason (see AntigravityAdapter)."""
        return "Alloy could not verify this CLI's login."

    def cli_version(self) -> str:
        b = self.resolved_bin()
        if not b:
            return ""
        try:
            out = subprocess.run(
                [b, "--version"],
                capture_output=True,
                text=True,
                timeout=15,
                stdin=subprocess.DEVNULL,
                env=routing.clean_env(),
            )
            lines = strip_ansi((out.stdout or out.stderr or "").strip()).splitlines()
            return lines[0] if lines else ""
        except Exception:
            return ""

    def model(self) -> "str | None":
        return None

    # -- invocation ---------------------------------------------------------- #
    def build_args(self, prompt_path: str, last_message_path: str, mode: str,
                   ctx: "dict | None" = None) -> "list[str]":
        raise NotImplementedError

    def prepare_env(self, ctx: "dict | None" = None) -> dict:
        """Env overrides for the child process. Default: none. An adapter that
        needs to confine a CLI's own state/config (agy) returns them here rather
        than mutating the user's real dotfiles."""
        return {}

    def parse(self, stdout: str, stderr: str, last_message: str) -> str:
        raise NotImplementedError

    def usage_args(self, argv: "list[str]") -> "list[str]":
        """Switch the CLI to its machine-readable output (ALLOY_CAPTURE_USAGE)."""
        return argv

    def usage(self, stdout_tail: str) -> "dict | None":
        """Normalized token usage from the machine-readable output, if any."""
        return None

    def resume_hint(self, ctx: "dict | None" = None) -> "str | None":
        # A ready-to-run command that continues THIS panelist's CLI session with
        # its full context after alloy killed it (timeout/stall). Only adapters
        # whose CLI accepts a caller-chosen session id can offer an exact one.
        # None = the CLI keeps no resumable session alloy can name.
        return None

    def capabilities(self) -> dict:
        return {
            "read_only": self.read_only,
            "experimental": self.experimental,
            "default_model": self.model(),
        }

    # -- dispatch hooks (no-ops unless an adapter needs them) ----------------- #
    def open_scope(self, pdir: str, repo: "str | None", managed_worktree: bool,
                   run_root: "str | None" = None):
        """Per-dispatch resources (returned object is close()d after the group is dead)."""
        return None

    def wrap_argv(self, argv: "list[str]", ctx: dict) -> "list[str]":
        """Final spawn gateway: called with the fully rewritten argv."""
        return argv

    def before_spawn(self, ctx: dict) -> None:
        return None

    def after_exit(self, ctx: dict) -> "str | None":
        """Tripwire verdict after the process group is dead; a string fails the call."""
        return None

    def output_error(self, stdout: str, stderr: str) -> "str | None":
        """A provider-reported failure that an exit status of zero would hide."""
        return None

    def redact_stdout(self, stdout: str) -> "tuple[str, int]":
        """Sanitize captured stdout for persistence. Structured adapters override
        this so escaped JSON syntax cannot hide string-leaf secrets."""
        return redact_secrets(stdout)

    def read_stdout(self, path: str, cap: int) -> str:
        """The finished run's stdout as the engine parses, redacts and persists it.
        Default: the first `cap` bytes of the sidecar file. An adapter whose CLI
        streams far more than its answer overrides this so the answer, which
        arrives last, is never cut off by the cap."""
        return read_text(path, cap)

    def observe_output(self, stdout: str) -> None:
        """Called once per finished dispatch with the redacted text read_stdout() returned
        (what is persisted as stdout.txt). Instrumentation only: an exception here never
        fails a run."""
        return None

    def provider_meta(self, stdout: str) -> dict:
        return {}

    def permission_overrides(self, write: bool) -> dict:
        return {}

    def doctor_extra(self, state: str) -> dict:
        return {"os_boundary": None, "auth_detail": None, "reason": None, "warnings": []}


class CodexAdapter(Adapter):
    name = "codex"
    bin = "codex"
    read_only = True
    install_hint = "npm install -g @openai/codex"
    auth_hint = "codex login   (or set CODEX_API_KEY / OPENAI_API_KEY)"

    def is_authed(self) -> bool:
        if setting("CODEX_API_KEY") or setting("OPENAI_API_KEY"):
            return True
        home = setting("CODEX_HOME") or os.path.join(
            os.path.expanduser("~"), ".codex"
        )
        return os.path.isfile(os.path.join(home, "auth.json"))

    def model(self) -> "str | None":
        return setting("ALLOY_CODEX_MODEL")

    def build_args(self, prompt_path: str, last_message_path: str, mode: str,
                   ctx: "dict | None" = None) -> "list[str]":
        # Prompt is fed on stdin (NOT as an argv prompt): passing both a prompt
        # arg AND stdin makes codex append stdin as a <stdin> block, so we pass
        # neither a prompt arg nor '-'. `-o` captures only the final message.
        args = [
            "exec",
            "--skip-git-repo-check",
            "-s",
            "read-only",
            "--color",
            "never",
            "-o",
            last_message_path,
        ]
        if web_enabled():
            # Hosted web-search tool; orthogonal to the read-only FS sandbox.
            args += ["-c", "tools.web_search=true"]
        # Pin reasoning effort so a panel run doesn't inherit a global
        # `model_reasoning_effort = "xhigh"` from ~/.codex/config.toml that
        # routinely blows the timeout. Override with ALLOY_CODEX_EFFORT
        # (e.g. medium / xhigh), or set it to "inherit" to use the user's config.
        effort = setting("ALLOY_CODEX_EFFORT", "high")
        if effort and effort.lower() not in ("inherit", "default"):
            args += ["-c", f"model_reasoning_effort={effort}"]
        m = self.model()
        if m:
            args += ["-m", m]
        return args

    def resume_hint(self, ctx: "dict | None" = None) -> "str | None":
        # codex assigns its own session id (no way to choose one up front), so
        # the best exact-ish handle is "the most recent codex session".
        # (codex exec has no headless deadline flag to mirror alloy's timeout.)
        return ("codex exec resume --last -s read-only --skip-git-repo-check "
                "'<continue prompt>'   # --last = codex's most recent session; "
                "confirm it is this run's")

    def usage_args(self, argv: "list[str]") -> "list[str]":
        return argv if "--json" in argv else argv[:1] + ["--json"] + argv[1:]

    @staticmethod
    def _events(stdout: str) -> "list[dict]":
        return [e for e in (json_object(line) for line in stdout.splitlines()) if e]

    def usage(self, stdout_tail: str) -> "dict | None":
        # `turn.completed` carries cumulative usage for the exec call. OpenAI
        # counts cached tokens inside input_tokens and reasoning inside output
        # (verified: output 34 with reasoning 27 for a two-digit answer).
        done = [e for e in self._events(stdout_tail) if e.get("type") == "turn.completed"]
        u = done[-1].get("usage") if done else None
        if not isinstance(u, dict):
            return None
        cached = _count(u.get("cached_input_tokens"))
        return _usage(_count(u.get("input_tokens")) - cached, cached, u.get("cache_write_input_tokens"),
                      u.get("output_tokens"), u.get("reasoning_output_tokens"), turns=len(done),
                      source="codex-jsonl")

    def parse(self, stdout: str, stderr: str, last_message: str) -> str:
        lm = strip_ansi(last_message).strip()
        if lm:
            return lm
        events = self._events(stdout) if capture_usage() else []
        if events:
            # --json mode without -o output: the last agent message is the answer.
            messages = [e["item"].get("text", "") for e in events
                        if e.get("type") == "item.completed" and isinstance(e.get("item"), dict)
                        and e["item"].get("type") == "agent_message"]
            return strip_ansi(messages[-1]).strip() if messages else ""
        out = strip_ansi(stdout).strip()
        if out:
            return out
        # Last resort (e.g. killed mid-generation): codex streams its reasoning
        # preamble to stderr, so salvage that rather than returning nothing.
        return strip_ansi(stderr).strip()


# agy's headless permission model CHANGED at 1.1.x, and the change is what makes
# it usable as a panelist at all. Verified on 1.0.16: print mode AUTO-EXECUTED
# every tool (file writes AND shell) regardless of --sandbox / --mode plan /
# settings. Verified on 1.1.7: print mode instead AUTO-DENIES any tool that is not
# in `permissions.allow` -- it cannot prompt, so unlisted tools fail closed. That
# turns a settings.json allow-list into real enforcement, so alloy gates the whole
# read-only posture on the CLI reporting at least this version.
_AGY_MIN_ENFORCED = (1, 1, 0)
_AGY_VERSION_RE = re.compile(r"(\d+)\.(\d+)(?:\.(\d+))?")

# The prompt is handed to agy as a FILE (it ignores stdin in print mode as of
# 1.1.7), so this is the only text that ever reaches argv.
_AGY_ARGV_PROMPT = (
    "Read the file {path} in full -- it contains your complete instructions -- "
    "then carry them out and write your answer to me directly. "
    "This is a read-only consult: analyse and explain, never modify anything."
)


class AntigravityAdapter(Adapter):
    # Google's Antigravity CLI (the `agy` binary), running Gemini 3.x.
    #
    # Read-only is ENFORCED BY THE CLI, not by asking the model nicely, via three
    # layers -- all verified live against agy 1.1.7:
    #   1. An allow-list in settings.json naming only read tools. In headless
    #      print mode any tool outside it is auto-denied (agy exits 0 with an
    #      empty stdout and a "tool required the X permission" line on stderr, so
    #      the engine already classifies the run as `empty` with that reason).
    #      Asking it to write a file yields the write_file denial; asking it to
    #      run a shell command yields the command denial. NOTE: do NOT also set
    #      toolPermission:"strict" -- it overrides the allow-list and denies the
    #      READ tools too, producing a panelist that can never answer.
    #   2. An isolated HOME per run (prepare_env), so that settings.json is OURS
    #      and never the user's, and so agy's conversation state, scratch dir and
    #      caches land in the disposable run dir instead of ~/.gemini. agy ignores
    #      the process cwd entirely (it writes into its own scratch dir), which is
    #      why confining HOME -- not cwd -- is what actually contains it.
    #   3. Access via explicit `--add-dir` roots plus
    #      allowNonWorkspaceAccess:false, so reads are scoped to the repo, the
    #      prompt file, and (for Checkers) the private gate-log directory rather
    #      than to all of $HOME or either temporary-directory root.
    # The auth files are symlinked (never copied) into the isolated HOME, so no
    # token is duplicated onto disk. On macOS a keychain search-list plist is
    # GENERATED in the isolated HOME too (see _keychain_plist) -- agy stores
    # its OAuth token in the login keychain, and without that config its token
    # save falls through to the System keychain and raises an admin-auth
    # Keychain dialog on every refresh. That plist only configures agy's own
    # keychain use: Alloy never reads the keychain or runs `security` itself,
    # so it cannot verify a keychain-only login (see _auth_evidence; `doctor`
    # reports auth `unknown` and the first dispatch reports `auth` if wrong).
    # Never pass --dangerously-skip-permissions: it disables layer 1 outright.
    #
    # On an older agy (< 1.1.0) none of this holds, so the adapter reports
    # read_only=False + experimental=True and the engine refuses it unless the
    # user sets ALLOY_ALLOW_UNSANDBOXED=1 -- the pre-0.1.8 behaviour.
    name = "antigravity"
    bin = "agy"
    stdin_from_prompt = False   # agy treats a file on stdin as a denied read_file target
    install_hint = "curl -fsSL https://antigravity.google/cli/install.sh | bash"
    auth_hint = "run `agy` once to sign in   (or set ANTIGRAVITY_API_KEY)"

    # Latest Gemini family seat at high effort (currently 3.6 Flash High). agy
    # also lists Claude 4.6 / GPT-OSS; those would duplicate the claude / codex
    # seats. `agy models` lists the rest (gemini-3.6-flash-low for cheap/fast,
    # gemini-3.1-pro-high for the previous Pro). Override: ALLOY_ANTIGRAVITY_MODEL.
    default_model = "gemini-3.6-flash-high"

    # Read tools get an allow-rule; everything else fails closed. Bare tool names
    # (no "(target)" suffix) mean "any target" on agy 1.1 -- with allowNonWorkspaceAccess
    # false the reachable targets are the --add-dir workspace roots.
    READ_TOOLS = (
        "read_file", "view_file", "view_file_outline", "view_code_item",
        "list_dir", "grep_search", "find_by_name", "codebase_search",
    )
    # Redundant with the default-deny above (belt and braces): if a future agy
    # ever loosens the headless default, these stay explicitly denied.
    WRITE_TOOLS = (
        "command", "run_command", "write_file", "write_to_file", "edit_file",
        "replace_file_content", "sed_file", "create_file", "delete_file",
    )
    # Only denied when the user turns web research off (ALLOY_WEB=0). Hosted
    # search is read-only and on by default, matching the other panelists.
    WEB_TOOLS = ("search_web", "read_url_content", "browser_navigate")
    # agy 1.2.12 ignores bare names and needs read_file(/abs/dir) for each
    # --add-dir root. Keep both grammars; each release ignores the other's
    # entries. These denials keep the same posture in the new grammar.
    WRITE_GRANTS = ("command(*)", "write_file(*)")
    WEB_GRANTS = ("read_url(*)", "execute_url(*)")

    def _agy_version(self) -> "tuple[int, int, int] | None":
        cached = getattr(self, "_ver_cache", "unset")
        if cached != "unset":
            return cached
        m = _AGY_VERSION_RE.search(self.cli_version())
        ver = (int(m.group(1)), int(m.group(2)), int(m.group(3) or 0)) if m else None
        self._ver_cache = ver
        return ver

    def _enforced(self) -> bool:
        """True when the installed agy is new enough to fail closed in headless
        mode (see _AGY_MIN_ENFORCED). Everything read-only hangs off this."""
        if not self.detect():
            return False
        ver = self._agy_version()
        return bool(ver and ver >= _AGY_MIN_ENFORCED)

    # read_only / experimental are properties, not class constants, because they
    # depend on the INSTALLED CLI's version. The engine reads them off instances.
    @property
    def read_only(self) -> bool:      # type: ignore[override]
        return self._enforced()

    @property
    def experimental(self) -> bool:   # type: ignore[override]
        return not self._enforced()

    def _auth_evidence(self) -> "bool | None":
        """Login evidence without touching the macOS keychain (operator policy: Alloy
        never reads it, never runs `security`).
        True   an API key is set, or agy's own token/credential file exists.
        False  no evidence and the platform keeps no login anywhere else.
        None   unknown: on macOS a fresh agy login lives ONLY in the login keychain
               (the token file is a fallback agy writes when a keyring save fails), so
               a healthy install can have no auth file at all. Alloy cannot tell that
               apart from a signed-out one, and says so instead of guessing."""
        if (setting("ANTIGRAVITY_API_KEY") or setting("GEMINI_API_KEY")
                or setting("GOOGLE_API_KEY")):
            return True
        # agy keeps its CLI state under ~/.gemini/antigravity-cli but shares the
        # Google OAuth login with ~/.gemini/oauth_creds.json.
        gdir = os.path.join(os.path.expanduser("~"), ".gemini")
        for name in ("oauth_creds.json", "google_accounts.json"):
            if os.path.isfile(os.path.join(gdir, name)):
                return True
        if os.path.isfile(os.path.join(gdir, "antigravity-cli",
                                       "antigravity-oauth-token")):
            return True
        return None if sys.platform == "darwin" else False

    def is_authed(self) -> bool:
        # An UNKNOWN login counts as usable, so agy stays routable and dispatchable:
        # routing and execute gate on auth_state() == "ready". A signed-out agy is
        # then reported honestly by the first real dispatch (status `auth`, see
        # _AUTH_FAIL_RE), and `doctor` shows auth `unknown` meanwhile (auth_status).
        return self._auth_evidence() is not False

    def auth_status(self, state: str) -> "str | None":
        if state == "ready" and self._auth_evidence() is None:
            return "unknown"
        return super().auth_status(state)

    def auth_note(self) -> str:
        return ("Alloy never reads the macOS keychain, where agy keeps its login, so it "
                "cannot verify it.")

    def model(self) -> "str | None":
        return setting("ALLOY_ANTIGRAVITY_MODEL", self.default_model)

    # -- sandbox: an isolated HOME holding our settings.json ------------------ #
    # Files symlinked (not copied) from the real ~/.gemini so agy finds the
    # existing Google login without duplicating a token onto disk.
    _AUTH_LINKS = (
        "oauth_creds.json",
        "google_accounts.json",
        os.path.join("antigravity-cli", "antigravity-oauth-token"),
    )

    # macOS only: agy also keeps its OAuth token in the login keychain (agy
    # itself talks to the keychain; Alloy never does). Both the keychain search list AND the
    # default keychain resolve through $HOME/Library/Preferences/
    # com.apple.security.plist, so inside the isolated HOME only the *System*
    # keychain is in scope -- and agy's token save then needs admin auth,
    # raising a Keychain dialog on every token refresh (while the keychain
    # copy of the token goes permanently stale). Fix: GENERATE that plist
    # inside the isolated HOME with ABSOLUTE DbName paths to the user's real
    # login keychain. All verified live: the real plist's tilde-relative
    # DbNames re-break under an isolated HOME, and without the DefaultKeychain
    # key writes still raise the dialog ("Keychain Not Found") even when the
    # search list resolves. A generated file, deliberately NOT a symlink into
    # ~/Library: users zip up and share the alloy state dir (and, under
    # ALLOY_ANTIGRAVITY_HOME=run, the run dir itself) for debugging, and
    # `zip -r`/`cp -RL`/backup agents dereference symlinks -- a Keychains link
    # would copy the whole credential store into the archive. With a copy, agy
    # can also only ever corrupt its own sandbox config, never the user's
    # global one. Auth state is deliberately shared, not isolated -- same
    # rationale as _AUTH_LINKS above. Regenerated on every run, so it
    # self-heals if the user's home moves.
    _KC_GUID = "{87191ca3-0fc9-11d4-849a-000502b52122}"  # Apple CSP/DL module (fixed)

    def _keychain_plist(self) -> "str | None":
        """com.apple.security.plist XML for the isolated HOME, or None when
        agy will never touch the keyring (API-key auth) or there is no login
        keychain to point at (headless account)."""
        if (setting("ANTIGRAVITY_API_KEY") or setting("GEMINI_API_KEY")
                or setting("GOOGLE_API_KEY")):
            return None  # least privilege: with a key, agy skips OAuth entirely
        db = os.path.join(os.path.expanduser("~"), "Library", "Keychains",
                          "login.keychain")
        if not os.path.isfile(db + "-db"):  # the modern on-disk suffix
            return None
        esc = db.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        entry = ("\t\t<dict>\n"
                 "\t\t\t<key>DbName</key>\n"
                 "\t\t\t<string>%s</string>\n"
                 "\t\t\t<key>GUID</key>\n"
                 "\t\t\t<string>%s</string>\n"
                 "\t\t\t<key>SubserviceType</key>\n"
                 "\t\t\t<integer>6</integer>\n"
                 "\t\t</dict>\n") % (esc, self._KC_GUID)
        return ('<?xml version="1.0" encoding="UTF-8"?>\n'
                '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"'
                ' "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
                '<plist version="1.0">\n<dict>\n'
                "\t<key>DLDBSearchList</key>\n\t<array>\n" + entry +
                "\t</array>\n"
                "\t<key>DefaultKeychain</key>\n\t<array>\n" + entry +
                "\t</array>\n"
                "</dict>\n</plist>\n")

    def _settings(self, ctx: "dict | None" = None) -> dict:
        dirs = ["read_file(%s)" % d for d in (ctx or {}).get("agy_add_dirs", [])]
        ver = self._agy_version()
        # agy 1.2.12 fails closed if allow still lists bare tool names or the
        # 1.1 deny set: headless read_file is auto-denied even with path grants.
        # Emit the grammar it rewrites to. 1.1 keeps both grammars.
        if ver and ver >= (1, 2, 0):
            deny = list(self.WRITE_GRANTS)
            if not web_enabled():
                deny += list(self.WEB_GRANTS)
            return {
                "enableTerminalSandbox": True,
                "showTips": False,
                "showFeedbackSurvey": False,
                "permissions": {"allow": dirs, "deny": deny},
            }
        deny = list(self.WRITE_TOOLS) + list(self.WRITE_GRANTS)
        if not web_enabled():
            deny += list(self.WEB_TOOLS) + list(self.WEB_GRANTS)
        return {
            # No toolPermission key on purpose -- see the class comment.
            "allowNonWorkspaceAccess": False,
            "enableTerminalSandbox": True,
            "notifications": False,
            "showTips": False,
            "showFeedbackSurvey": False,
            "permissions": {"allow": list(self.READ_TOOLS) + dirs, "deny": deny},
        }

    def _home(self, ctx: "dict | None") -> "str | None":
        """Build (idempotently) the HOME agy is confined to, and return it.

        Alloy-owned and shared across runs by default (under XDG_STATE_HOME, next
        to the run dirs): agy unpacks ~13MB of language-server binaries and caches
        into its HOME on first use, so a fresh one per run would re-pay that in
        disk and startup latency every time. Sharing is safe -- a print-mode call
        never resumes prior state unless asked (`--continue`/`--conversation`,
        which this adapter never passes). Set ALLOY_ANTIGRAVITY_HOME=run for a
        throwaway one inside the run dir, or to a path of your own."""
        pdir = (ctx or {}).get("pdir")
        raw = "run" if (ctx or {}).get("managed_worktree") else (setting("ALLOY_ANTIGRAVITY_HOME") or "").strip()
        if raw and raw.lower() != "run":
            home = os.path.abspath(os.path.expanduser(raw))
        elif raw.lower() == "run":
            if not pdir:
                return None
            home = os.path.join(pdir, "agy_home")
        else:
            home = os.path.join(os.path.dirname(default_run_root()), "agy-home")
        cli = os.path.join(home, ".gemini", "antigravity-cli")
        os.makedirs(cli, exist_ok=True)
        _chmod(home, 0o700)
        real = os.path.join(os.path.expanduser("~"), ".gemini")
        for rel in self._AUTH_LINKS:
            src, dst = os.path.join(real, rel), os.path.join(home, ".gemini", rel)
            if os.path.exists(src):
                _relink(src, dst)  # API-key auth still works; is_authed gated this
        if sys.platform == "darwin":
            # 0.1.11 dev builds briefly symlinked ~/Library/Keychains here;
            # remove any such link before the generated-plist config below.
            legacy = os.path.join(home, "Library", "Keychains")
            if os.path.islink(legacy):
                try:
                    os.unlink(legacy)
                except OSError:
                    pass
            plist = self._keychain_plist()
            if plist is not None:
                prefs = os.path.join(home, "Library", "Preferences")
                try:
                    os.makedirs(prefs, exist_ok=True)
                    write_atomic(os.path.join(
                        prefs, "com.apple.security.plist"), plist)
                except OSError:
                    pass  # agy falls back to file token storage
        write_atomic(os.path.join(cli, "settings.json"),
                     json.dumps(self._settings(ctx), indent=2))
        return home

    def prepare_env(self, ctx: "dict | None" = None) -> dict:
        home = self._home(ctx)
        return {"HOME": home} if home else {}

    def build_args(self, prompt_path: str, last_message_path: str, mode: str,
                   ctx: "dict | None" = None) -> "list[str]":
        if ctx is None:
            ctx = {}
        # agy ignores stdin in print mode (1.1.7), so the prompt goes in a file it
        # is pointed at -- never on argv (ARG_MAX, `ps` leakage, quoting). The file
        # lives in its own directory so the --add-dir grant covers the prompt only,
        # not the sibling panelists' captured answers in the run dir.
        pdir = ctx.get("pdir") or os.path.dirname(os.path.abspath(prompt_path))
        pin = os.path.join(pdir, "prompt_in")
        os.makedirs(pin, exist_ok=True)
        _chmod(pin, 0o700)
        staged = os.path.join(pin, "prompt.md")
        try:
            shutil.copyfile(prompt_path, staged)
            _chmod(staged, 0o600)
        except OSError:
            staged = os.path.abspath(prompt_path)  # fall back to the original
        # `--mode plan` steers toward analysis over edits. It is an intent hint
        # only (unenforced); the allow-list is what actually stops writes.
        args = ["-p", _AGY_ARGV_PROMPT.format(path=staged), "--mode", "plan"]
        ctx["agy_add_dirs"] = [os.path.abspath(d) for d in
                               (os.path.dirname(staged), ctx.get("repo")) if d]
        if mode == "review":
            # Gate wrappers may print a path for fuller evidence than Alloy's
            # bounded review packet carries. Keep that evidence in one private,
            # non-temporary root rather than broadening access to /tmp.
            logs = gate_log_dir()
            os.makedirs(logs, exist_ok=True, mode=0o700)
            _chmod(logs, 0o700)
            ctx["agy_add_dirs"].append(logs)
        repo = ctx.get("repo")
        if repo:
            # Linked worktrees keep HEAD and shared metadata outside the checkout.
            try:
                with open(os.path.join(repo, ".git"), encoding="utf-8") as f:
                    pointer = f.read().strip()
                if pointer.startswith("gitdir:"):
                    target = pointer[len("gitdir:"):].strip()
                    if target and not any(c in target for c in "\r\n\0"):
                        gitdir = os.path.abspath(os.path.join(repo, target))
                        ctx["agy_add_dirs"].append(gitdir)
                        parent = os.path.dirname(gitdir)
                        if os.path.basename(parent) == "worktrees":
                            ctx["agy_add_dirs"].append(os.path.dirname(parent))
            except (OSError, UnicodeError):
                pass  # Ordinary checkouts, missing files, and malformed pointers.
        ctx["agy_add_dirs"] = list(dict.fromkeys(ctx["agy_add_dirs"]))
        for d in ctx["agy_add_dirs"]:
            args += ["--add-dir", d]
        # Match agy's own print-mode deadline (default 5m) to alloy's, so the
        # engine's timeout is the one that decides, not a hidden CLI default.
        timeout_s = ctx.get("timeout_s")
        if timeout_s:
            args += ["--print-timeout", f"{int(timeout_s)}s"]
        m = self.model()
        if m:
            args += ["--model", m]
        effort = setting("ALLOY_ANTIGRAVITY_EFFORT")   # low|medium|high
        if effort:
            args += ["--effort", effort]
        return args

    def usage_args(self, argv: "list[str]") -> "list[str]":
        return _swap_flag(argv, "--output-format", "json")

    def usage(self, stdout_tail: str) -> "dict | None":
        # agy counts cached tokens inside input_tokens and thinking inside
        # output (verified: total_tokens == input_tokens + output_tokens).
        u = (json_object(stdout_tail) or {}).get("usage")
        if not isinstance(u, dict):
            return None
        cached = _count(u.get("cache_read_tokens"))
        return _usage(_count(u.get("input_tokens")) - cached, cached, 0,
                      u.get("output_tokens"), u.get("thinking_tokens"),
                      turns=(json_object(stdout_tail) or {}).get("num_turns"), source="agy-json")

    def parse(self, stdout: str, stderr: str, last_message: str) -> str:
        # The answer is rendered to stdout; stderr carries noise such as
        # "Shell cwd was reset to ..." and the tool-denied notice. Never parse
        # stderr as the answer -- a denial must surface as an empty result (the
        # engine reports the stderr tail as the reason), not as a fake answer.
        obj = json_object(stdout) if capture_usage() else None
        if obj is not None and "response" in obj:
            return strip_ansi(str(obj.get("response") or "")).strip()
        return strip_ansi(stdout).strip()


class LlmAdapter(Adapter):
    # Simon Willison's `llm` CLI: by default it just calls a model API with no
    # filesystem or shell tools, so it is read-only by nature. Marked
    # experimental (not yet live-verified in CI); opt in via ALLOY_PANELISTS.
    name = "llm"
    bin = "llm"
    read_only = True
    experimental = True
    install_hint = "uv tool install llm   (or: pipx install llm)"
    auth_hint = "llm keys set openai   (or set OPENAI_API_KEY)"

    def is_authed(self) -> bool:
        base = setting("LLM_USER_PATH") or os.path.join(
            os.path.expanduser("~"), ".config", "io.datasette.llm")
        if os.path.isfile(os.path.join(base, "keys.json")):
            return True
        return bool(setting("OPENAI_API_KEY"))

    def model(self) -> "str | None":
        return setting("ALLOY_LLM_MODEL")

    def build_args(self, prompt_path: str, last_message_path: str, mode: str,
                   ctx: "dict | None" = None) -> "list[str]":
        # `llm` reads the prompt from stdin when none is given as an argument.
        args: "list[str]" = []
        m = self.model()
        if m:
            args += ["-m", m]
        return args

    def parse(self, stdout: str, stderr: str, last_message: str) -> str:
        return strip_ansi(stdout).strip()


class OpenCodeAdapter(Adapter):
    # opencode has `opencode run <message>` but no verified read-only mode (it is
    # an agentic editor). Registered so `doctor` lists it; refused by default
    # unless ALLOY_ALLOW_UNSANDBOXED=1. read_only stays False on purpose.
    name = "opencode"
    bin = "opencode"
    read_only = False
    experimental = True
    install_hint = "see https://opencode.ai (npm i -g opencode-ai)"
    auth_hint = "opencode auth login"

    def model(self) -> "str | None":
        return setting("ALLOY_OPENCODE_MODEL")

    def build_args(self, prompt_path: str, last_message_path: str, mode: str,
                   ctx: "dict | None" = None) -> "list[str]":
        args = ["run"]
        m = self.model()
        if m:
            args += ["-m", m]
        return args

    def parse(self, stdout: str, stderr: str, last_message: str) -> str:
        return strip_ansi(stdout).strip()


# --------------------------------------------------------------------------- #
# Cursor: canonical name, OS write boundary, spawn gateway, tripwires
# --------------------------------------------------------------------------- #
# `cursor-agent` has no OS-enforced read-only mode. Its `--mode ask` and
# `--sandbox` flags are model/tool-mode controls, and the recorded boundary probe
# showed plan mode and its sandbox flag writing outside the workspace. The write
# boundary is therefore a macOS `sandbox-exec` profile generated here, and EVERY
# Cursor process -- auth status, version/help, model discovery, panels, Makers,
# Checkers -- is spawned only through cursor_command(): it validates the boundary,
# validates the final argv against a closed per-role grammar, writes the profile
# and returns the wrapped argv.
#
# The `cursor-agent` that a user runs is a shell launcher; Alloy never executes it.
# A panel/Checker profile denies process execution, and a launcher needs a shell and
# coreutils. Alloy instead resolves the pinned build's directory and starts that
# build's own bundled Node runtime directly: `<dir>/node --use-system-ca <dir>/index.js`.
# A panel or Checker allows exactly three literal executables: node, the build's rg,
# and /usr/bin/sw_vers. Under Alloy, the OS sandbox denies shell execution and file
# writes outside the task's allowed paths; the model may be offered tools it cannot use.
# Every role uses file credentials and denies security execution and keychain access.
ADAPTER_ALIASES = {"cursor-agent": "cursor"}


def normalize_adapter_name(name: str) -> str:
    """Map a legacy adapter name to its canonical one. Applied at config/input
    boundaries only; run artifacts always carry the canonical name."""
    name = (name or "").strip()
    return ADAPTER_ALIASES.get(name, name)


def _first_setting(*keys: str) -> "str | None":
    """First non-empty setting in order: the canonical key wins over a legacy one."""
    for key in keys:
        value = setting(key)
        if value:
            return value
    return None


# Module constants (not environment knobs): nothing the environment or a config
# file can set may relax the boundary. Unit tests patch these to point at a mock.
SANDBOX_EXEC = "/usr/bin/sandbox-exec"     # never resolved through PATH
SANDBOX_TRUSTED_UID = 0
CURSOR_PLATFORM = "darwin"                 # the only supported Cursor execution platform
CURSOR_SANDBOX_PROFILE_VERSION = 4      # 4: file login only; keychain access denied
# Ask mode's no-shell behaviour is evidence-backed only for these exact builds.
# A date floor would silently trust every later or same-day unmeasured build.
CURSOR_SUPPORTED_VERSIONS = ("2026.09.28-64d2043",)
CURSOR_VERSION_RE = re.compile(r"\b(\d{4}\.\d{1,2}\.\d{1,2}-[0-9A-Za-z]+)\b")
CURSOR_BUILD_DIR_RE = re.compile(r"^\d{4}\.\d{1,2}\.\d{1,2}-[0-9A-Za-z]+$")
# Where a Cursor install keeps its builds (`<versions root>/<build>/{node,index.js,...}`),
# relative to the login home. Used when the `cursor-agent` on PATH is not itself inside a
# build directory (a local wrapper or guard script): the wrapper is never executed or followed
# (only its `#!` marker is read), and only a supported build under this root is used.
CURSOR_VERSIONS_ROOT = os.path.join(".local", "share", "cursor-agent", "versions")
# The CLI's own name. The shell launcher exports it as CURSOR_INVOKED_AS (basename of the
# launcher path, so `agent` or `cursor-agent`); the CLI reads that variable before argv[0].
# sandbox-exec cannot set argv[0] of what it starts, so the variable is the whole mechanism.
CURSOR_NAME = "cursor-agent"
# What the launcher puts between the runtime binary and the entry script (it probes
# `node --use-system-ca --version` first and falls back without the flag). Fixed here: the
# preflight proves the pinned build's runtime accepts it.
CURSOR_NODE_ARGS = ("--use-system-ca",)
# Besides bundled node and rg, panels/Checkers may execute only the verified, root-owned
# OS-version tool. File credentials eliminate the CLI's need for /usr/bin/security.
CURSOR_SYSTEM_EXEC = ("/usr/bin/sw_vers",)
CURSOR_DEFAULT_MODEL = "composer-2.5"
CURSOR_EFFORTS = ("none", "minimal", "low", "medium", "high", "xhigh", "max")
CURSOR_BOUNDARY_MESSAGE = ("Cursor installed/authenticated, but no supported OS write sandbox "
                           "is available; Cursor roles are refused.")
CURSOR_FP_MAX_ENTRIES = 1_000_000
CURSOR_FP_MAX_BYTES = 16 << 30
# The only Unix-domain socket a Cursor process may connect to: the resolver.
CURSOR_ALLOWED_UNIX_SOCKET = "/private/var/run/mDNSResponder"
# Mach services a Cursor process may look up. Every other lookup is denied: a service
